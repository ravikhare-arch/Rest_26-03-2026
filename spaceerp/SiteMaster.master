    <script>

    $(document).bind("keyup keydown", function (e) {
        if (e.ctrlKey && e.keyCode === 80) {
            debugger;
          //  window.frames["iframe"]
            window.frames["iframe"].focus();
            window.frames["iframe"].print();
            
            return false;
        }
        return true;
    });

</script>
