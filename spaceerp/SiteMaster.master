    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
    <script>
        $(function () {
            Sys.WebForms.PageRequestManager.getInstance().add_pageLoaded(function () {
                $(".js-example-placeholder-single").select2({
                    placeholder: "Select a state",
                    allowClear: true
                });
            });
        });

        $(function () {
            $(".datepicker").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: "dd/mm/yy"

            });
        });
    </script>
    <script type="text/javascript">

        $(document).on('click', ".tbClose", function () {
            // var removeDiv =
            debugger;
            var len = $(this).parent().parent().prevAll().length;
            ($(this.offsetParent.hash)).remove()
            this.offsetParent.parentNode.remove();
            $('.nav-tabs li:eq(' + (len - 1) + ') a').tab('show')
            $('.nav-tabs li:eq(' + (len - 1) + ')').addClass('active')


        });


        $('#side-menu li a').click(function (e) {
            e.preventDefault();
            debugger;

            var href = this.href;
            var tabNameExists = false;
            nameToCheck = $.trim(this.innerText);
            $('#tabs ul li a span').each(function (i) {
                console.log(this.innerText);
                if (this.innerText == nameToCheck) {
                    tabNameExists = true;
                }
            });
            if (tabNameExists == false) {
                var newTabName = $.trim(this.innerText).replaceAll(/\s/g, '').toUpperCase()
                newTabName = newTabName.replace(/[^a-zA-Z ]/g, "");
                var id = newTabName// $(".nav-tabs").children().length;

                var t = '<li class="nav-item"><a id="a' + id + '" load-in="frame' + id + '" class="nav-link" href="#hr' + id + '" data-toggle="tab"><span style="font-size:14px; float: left; padding: 0 20px 0 0;font-weight:400;">' + this.innerText + '</span> &nbsp; <span class="tbClose" style="float:right"><i class="fa fa-times" style="display:block;float:right;"></i></span></a></li>';
                $(".nav-tabs").append(t);
                var tcontent = '<div id="hr' + id + '" class="tab-pane fade in "><iframe id="frame' + id + '" class="responsive-iframe" style="border:0px;min-height:485px;" width="100%" src="' + this.href + '" onload="resizeIframe(this)"></iframe></div>'
                $(".tab-content").append(tcontent);
                $(".tab-content>div").removeClass('show');
                $(".tab-content>div").removeClass('active');
                $('.nav-tabs li a').removeClass('active')
                $('.nav-tabs li').removeClass('active')

                $('#menutab a[href="hr' + id + '"]').tab('show')
                $("#hr" + id).addClass("show");
                $('#a' + id).addClass("active");
                //$("#hr1" + id).first().addClass("active");
            }
            else {
                // alert("This tab already exist");
                $("div.warning").fadeIn(300).delay(1500).fadeOut(), 5000;
            }
            
        });

        $(document).on('click', ".nav-link", function () {
            event.preventDefault();
            var id_of_selected = $(this).attr('load-in');
            var link_to_load = $('.tab-content #' + id_of_selected).contents().get(0).location.href;//$(this).attr('href');
            var iframe_to_load = $(document).find('#' + id_of_selected);
            $(".tab-content>div").removeClass('show');
            iframe_to_load.parent().addClass('in show')
        });


    </script>
    <script>
        function resizeIframe(obj) {
            obj.style.height = obj.contentWindow.document.documentElement.scrollHeight + 'vh';
        }
    </script>

    <script>
        debugger;
        window.onload = function () {
            var scrollY = parseInt('<%=Request.Form["scrollY"] %>');
            if (!isNaN(scrollY)) {
                window.scrollTo(0, scrollY);
            }
        };
        window.onscroll = function () {
            var scrollY = document.body.scrollTop;
            if (scrollY == 0) {
                if (window.pageYOffset) {
                    scrollY = window.pageYOffset;
                }
                else {
                    scrollY = (document.body.parentElement) ? document.body.parentElement.scrollTop : 0;
                }
            }
            if (scrollY > 0) {
                var input = document.getElementById("scrollY");
                if (input == null) {
                    input = document.createElement("input");
                    input.setAttribute("type", "hidden");
                    input.setAttribute("id", "scrollY");
                    input.setAttribute("name", "scrollY");
                    document.forms[0].appendChild(input);
                }
                input.value = scrollY;
            }
        };

    </script>

</body>
</html>
