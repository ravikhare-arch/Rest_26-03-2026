    <style>
.alert-box {
    position:absolute;
	padding: 10px;
    width: 350px;
  height: 50px;
  position:fixed; 
  top: calc(50% - 25px); 
  left: calc(50% - 200px);
    border: 1px solid transparent;
    border-radius: 4px;
    z-index:99999;  
}

.warning {
    color: #8a6d3b;
    background-color:#ddffff;
    border-color: #faebcc;
    box-shadow: 1px 2px blue;
    display: none;
}
.alert {
  padding: 20px;
  background-color: #f44336;
  color: white;
}
</style>
